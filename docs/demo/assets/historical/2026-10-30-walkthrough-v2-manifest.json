    {
      "cue": "c03",
      "start_s": 10.204,
      "seconds": 4.7,
      "caption": "NoCap checks every financial number in a draft against SEC filings.",
      "spoken_text": "No Cap checks every financial number in a draft against S E C filings.",
      "speech_sha256": "400051cde3265aa4ed1d1a219c381f553d0a85545d736d21d05c13bf14c8d4b3"
