    "segments": [
      {
        "start_s": 0,
        "end_s": 8,
        "caption": "Here's an NVIDIA earnings draft. Two figures look plausible. Let's check them before publishing.",
        "spoken_text": "Here's an NVIDIA earnings draft. Two figures look plausible. Let's check them before publishing.",
        "raw_duration_s": 5.962666666666666,
        "tempo": 1,
        "speech_sha256": "695c1f3e4d65cbc8d9420547c8dcdad5fbef0759cdb71432ded9357c2100c1bd"
      },
      {
        "start_s": 8,
        "end_s": 18,
        "caption": "Muse Spark extracts the claims. Code checks the SEC evidence. Seven pass, two are wrong, and two remain unverifiable.",
        "spoken_text": "Muse Spark extracts the claims. Code checks the S E C evidence. Seven pass, two are wrong, and two remain unverifiable.",
        "raw_duration_s": 8.528666666666666,
        "tempo": 1,
        "speech_sha256": "84cd0d94122b0eecb4ffe548b0ec0fa2fc497ceb37c5bfd151c19b6b931c5ba8"
      },
      {
        "start_s": 18,
        "end_s": 27,
        "caption": "Click eighteen percent. The draft says year over year, but eighteen percent is quarter-over-quarter growth.",
        "spoken_text": "Click eighteen percent. The draft says year over year, but eighteen percent is quarter-over-quarter growth.",
        "raw_duration_s": 6.184666666666667,
        "tempo": 1,
        "speech_sha256": "3a28c7fe4a800fa1c362f4dca7d07fcec2760cfbe1611a83d6b6140b87622021"
      },
      {
        "start_s": 27,
        "end_s": 35,
        "caption": "The receipt calculates the year-over-year change: about one hundred and six percent. We can inspect both filed values.",
        "spoken_text": "The receipt calculates the year-over-year change: about one hundred and six percent. We can inspect both filed values.",
        "raw_duration_s": 7.454666666666666,
        "tempo": 1,
        "speech_sha256": "58f255e85d50041282712dd17b62cc4eafd0aba57ee5af15584bbfbfd7b8a91c"
      },
      {
        "start_s": 35,
        "end_s": 42,
        "caption": "Now click earnings per share. The draft labels two dollars and twenty-two cents as GAAP.",
        "spoken_text": "Now click earnings per share. The draft labels two dollars and twenty-two cents as gap.",
        "raw_duration_s": 5.406666666666666,
        "tempo": 1,
        "speech_sha256": "5dea77d16cd2b2ff8fd20bac65eccb029d72da2834414c1649ce505860a52255"
      },
      {
        "start_s": 42,
        "end_s": 50,
        "caption": "That is the adjusted figure. The GAAP receipt says two dollars and forty-six cents, with the filing attached.",
        "spoken_text": "That is the adjusted figure. The gap receipt says two dollars and forty-six cents, with the filing attached.",
        "raw_duration_s": 6.729333333333333,
        "tempo": 1,
        "speech_sha256": "83ae4c91de17f8ac293bbe92fd9f1c4cb1940081381232af218a978654fa0e41"
      },
      {
        "start_s": 50,
        "end_s": 59,
        "caption": "Let's fix both. Muse Wonder proposes numeric edits; code constrains them and verifies the revised draft again.",
        "spoken_text": "Let's fix both. Muse Wonder proposes numeric edits; code constrains them and verifies the revised draft again.",
        "raw_duration_s": 7.562666666666667,
        "tempo": 1,
        "speech_sha256": "d69927a5f4bbe9fef6535151fb5e8abed6c05c64167c90f542d9e1081ca28aee"
      },
      {
        "start_s": 59,
        "end_s": 66,
        "caption": "The original stays on the left. The rechecked version shows exactly which numbers changed.",
        "spoken_text": "The original stays on the left. The rechecked version shows exactly which numbers changed.",
        "raw_duration_s": 5.3112916666666665,
        "tempo": 1,
        "speech_sha256": "a1a37bc640f2e6b3689b9a7707c5a1a4a43e32aa0d2df6c9c22558e057ebe686"
      },
      {
        "start_s": 66,
        "end_s": 78,
        "caption": "Each correction keeps its receipt. This is a recorded successful response, replayed through the actual interface, not a live speed test.",
        "spoken_text": "Each correction keeps its receipt. This is a recorded successful response, replayed through the actual interface, not a live speed test.",
        "raw_duration_s": 8.744666666666667,
        "tempo": 1,
        "speech_sha256": "c1ab7eed3b108de07cfa9078824a22333591257750c9832ad2bfa0f6ae8b56c5"
      },
      {
        "start_s": 78,
        "end_s": 88,
        "caption": "All eleven claims are checked again. The two errors are resolved. Guidance still has question marks; a forecast is not a filed fact.",
        "spoken_text": "All eleven claims are checked again. The two errors are resolved. Guidance still has question marks; a forecast is not a filed fact.",
        "raw_duration_s": 8.478666666666667,
        "tempo": 1,
        "speech_sha256": "836cce255db150ae77d6eb4d9920016a462ee6c92438c80660cef794de366649"
      },
      {
        "start_s": 88,
        "end_s": 94,
        "caption": "Copy the revised draft with its correction receipts.",
        "spoken_text": "Copy the revised draft with its correction receipts.",
        "raw_duration_s": 3.018666666666667,
        "tempo": 1,
        "speech_sha256": "c06dd7f2f441e1d43d41c0d19210b4cef003776332a0f94670248b6a376443bd"
      },
      {
        "start_s": 94,
        "end_s": 104,
        "caption": "A correct number can still arrive too late. Here is a roundup checked as of July twenty-ninth, sixteen hundred UTC.",
        "spoken_text": "A correct number can still arrive too late. Here is a roundup checked as of July twenty-ninth, sixteen hundred U T C.",
        "raw_duration_s": 7.605333333333333,
        "tempo": 1,
        "speech_sha256": "1a83551d524943ae4f31d911efa96f3ebe9edad570ebf23b256eb158e7682a7e"
      },
      {
        "start_s": 104,
        "end_s": 110,
        "caption": "Microsoft's filing arrived later. These claims are marked not public yet.",
        "spoken_text": "Microsoft's filing arrived later. These claims are marked not public yet.",
        "raw_duration_s": 4.649958333333333,
        "tempo": 1,
        "speech_sha256": "53e687037e5a6fac2b9da44d36257e2a28d1e938faa9c43c45cd5753220bf5d4"
      },
      {
        "start_s": 110,
        "end_s": 121,
        "caption": "Switch to Now and check again. Those two numbers become verifiable. The cutoff follows EDGAR acceptance time.",
        "spoken_text": "Switch to Now and check again. Those two numbers become verifiable. The cutoff follows EDGAR acceptance time.",
        "raw_duration_s": 6.986666666666666,
        "tempo": 1,
        "speech_sha256": "581f4308c3315fd48a6710f0df0e402698be8759d9ecb8d409777dee79232f45"
      },
      {
        "start_s": 121,
        "end_s": 133,
        "caption": "The same workflow handles a slide. Upload this seeded earnings table and select Check slide. SAM proposes regions; Spark reads the figures.",
        "spoken_text": "The same workflow handles a slide. Upload this seeded earnings table and select Check slide. SAM proposes regions; Spark reads the figures.",
        "raw_duration_s": 9.705958333333333,
        "tempo": 1,
        "speech_sha256": "393bbc05bd8d81424a8d5f38bedfa6bd1a7dd9e7f6062b17716aff47fd9e3512"
      },
      {
        "start_s": 133,
        "end_s": 147,
        "caption": "Click a numbered reading to open its receipt. Both planted errors are caught. Here Spark supplied the region after SAM found none. The image is a claim, not evidence.",
        "spoken_text": "Click a numbered reading to open its receipt. Both planted errors are caught. Here Spark supplied the region after SAM found none. The image is a claim, not evidence.",
        "raw_duration_s": 11.06,
        "tempo": 1,
        "speech_sha256": "4db04da2bd9e7927701906ad6d49db786446e6987e4b5a80fc00d3d97753ebd3"
      },
      {
        "start_s": 147,
        "end_s": 157,
        "caption": "Ask for one figure. Spark proposes the lookup; code builds a verified answer. Inspect its SEC footnotes.",
        "spoken_text": "Ask for one figure. Spark proposes the lookup; code builds a verified answer. Inspect its S E C footnotes.",
        "raw_duration_s": 7.838666666666667,
        "tempo": 1,
        "speech_sha256": "a283834df15e220d87bb20209dd1eb0702a70a9ffb904e89e9772a84aba93302"
      },
      {
        "start_s": 157,
        "end_s": 165,
        "caption": "NoCap: eleven companies, SEC receipts. Built during this hackathon by Robert Chang. Explore the saved examples.",
        "spoken_text": "No Cap: eleven companies, S E C receipts. Built during this hackathon by Robert Chang. Explore the saved examples.",
        "raw_duration_s": 8.056666666666667,
        "tempo": 1.0531590413943355,
