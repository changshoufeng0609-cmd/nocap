{
  "scope": "Deterministic MCP workflow development checks; no LLM agent evaluation or held-out data.",
  "scenarios": [
    {
      "id": "nvidia_match",
      "question": "Find NVIDIA revenue receipts for the quarter ending 2026-07-26, preserve their distinct filing versions, and verify the draft rounded to $96.2 billion. Return the verifier reason code.",
      "search": {
        "entity": "NVIDIA",
        "metric": "revenue",
        "as_of": null,
        "limit": 5
      },
      "verify": {
        "claim": {
          "id": "nvidia_match",
          "metric": "revenue",
          "metric_text": "revenue",
          "value_text": "$96.2 billion",
          "value": 96.2,
          "unit": "USD",
          "scale": "billions",
          "period_text": "Q2 FY2027",
          "period_type": "quarter",
          "comparison": "none",
          "basis": "GAAP",
          "forward_looking": false,
          "entity": "NVIDIA",
          "segment": null,
          "span_start": 0,
          "span_text": "NVIDIA Q2 FY2027 revenue was $96.2 billion.",
          "span_end": 43
        },
        "as_of": null
      },
      "expected_status": "verified",
      "expected_reason": "match"
    },
