# Template — copy to `.env` (gitignored) and fill in:  cp env.example .env
# Never commit real values.

# SEC EDGAR fair-access policy: automated requests must identify the requester
# (name + contact email) in the User-Agent header; max 10 requests/second.
SEC_USER_AGENT="Your Name your.email@example.com"

# Meta Model API key from https://dev.meta.ai (API keys tab). Standard-mode model IDs only.
MODEL_API_KEY=

# Extraction backend: meta (default), fireworks, baseten, modal. Restart the API after changes.
# See docs/open-weights.md. Choosing another backend never falls back to Meta.
RECEIPTS_EXTRACT_BACKEND=meta
FIREWORKS_API_KEY=
BASETEN_API_KEY=

# Your private Modal server URL, including /v1 (only after an approved deployment).
RECEIPTS_MODAL_BASE_URL=
# A Modal Proxy Token, NOT the Modal CLI token. Either combined ID.SECRET or the two fields below.
MODAL_PROXY_TOKEN=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Optional download token. Copy only HF_TOKEN into the named Modal secret receipts-hf.
HF_TOKEN=

# Optional overrides; leave commented to use the preset. Never embed credentials in the URL.
# RECEIPTS_EXTRACT_MODEL=muse-spark-1.3
# RECEIPTS_EXTRACT_BASE_URL=https://api.meta.ai/v1
# RECEIPTS_EXTRACT_API_KEY_ENV=MODEL_API_KEY
# RECEIPTS_EXTRACT_STRUCTURED=json_schema
# RECEIPTS_EXTRACT_EFFORT=minimal
# RECEIPTS_EXTRACT_MAX_TOKENS=8000
# RECEIPTS_EXTRACT_TIMEOUT_S=120

# API runtime settings are read from the process environment at startup. Export
# them before starting the API, or pass Uvicorn --env-file .env for an existing
# file. The extractor's later credential loading does not rebuild API settings.
# Run directly with --no-proxy-headers so the application sees the socket peer.

# Ordinary Check/Fix caches: defaults to false on Vercel, true locally. When set,
# only true enables persistence. false reads only committed snapshot caches,
# preserving saved examples, and never reads/writes ordinary draft caches.
# Persistent caches can contain draft fragments/model output and have no app TTL.
# Disabling persistence does not delete old caches or change provider retention.
# RECEIPTS_PERSIST_DRAFT_CACHES=false
# Cache path overrides require persistence=true to enable response-cache use.
# RECEIPTS_API_CACHE_DIR=data/api_cache
# RECEIPTS_SPARK_CACHE_DIR=data/cache/spark
# The local spend ledger keeps its existing API-cache directory even when draft
# persistence is disabled. Never change the shared database/namespace to reset it.
# RECEIPTS_REQUIRE_SHARED_BUDGET=1
# RECEIPTS_SPEND_NAMESPACE=nocap
# RECEIPTS_DAILY_BUDGET_USD=1
# RECEIPTS_SPEND_DATABASE_URL=

# Disables every response-cache read/write, including saved-example replay;
# unlike PERSIST_DRAFT_CACHES=false, saved examples then need model admission.
# RECEIPTS_NO_CACHE=1

# Pause new paid work without consuming rate allowance or resetting the ledger.
# Saved snapshot examples remain available unless all caching is disabled above.
# RECEIPTS_LIVE_REQUESTS_ENABLED=false
# RECEIPTS_LIVE_UNTIL=2026-11-05T02:00:00Z

# Forwarded-IP trust is disabled for direct/local requests by default. Set only
# the networks of trusted proxy socket peers that append the received connection
# to X-Forwarded-For. With --no-proxy-headers, the app walks right-to-left until the
# first untrusted hop. Do not use unrestricted ASGI forwarded-allow-ips="*".
# RECEIPTS_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# The real Vercel runtime uses its overwritten x-vercel-forwarded-for header.
# Do not set VERCEL on an exposed non-Vercel server to establish proxy trust.
# /api/health reports draft_cache_policy: snapshot_only, persistent, or disabled.
